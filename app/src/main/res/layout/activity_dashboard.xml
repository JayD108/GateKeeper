<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margin_large"
        android:gravity="center_horizontal">

        <!-- App Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔐 GateKeeper"
            android:textSize="@dimen/text_xlarge"
            android:textStyle="bold"
            android:textColor="@color/primary"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/margin_standard">

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_idle"
                    android:textSize="@dimen/text_normal"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvPairingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/status_not_paired"
                    android:textSize="@dimen/text_normal"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:id="@+id/tvLocationStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locations: Not set"
                    android:textSize="@dimen/text_normal"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Role Selection (shown once during setup) -->
        <TextView
            android:id="@+id/tvRoleLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select your role:"
            android:textSize="@dimen/text_large"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleP1"
            style="@style/Widget.GateKeeper.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_p1"
            android:layout_marginBottom="12dp"
            android:visibility="gone"
            app:icon="@android:drawable/ic_menu_mylocation" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRoleP2"
            style="@style/Widget.GateKeeper.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/role_p2"
            android:layout_marginBottom="24dp"
            android:visibility="gone"
            app:backgroundTint="@color/accent"
            app:icon="@android:drawable/ic_menu_myplaces" />

        <!-- Action Buttons (shown after role is selected) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSetLocations"
            style="@style/Widget.GateKeeper.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_set_locations"
            android:layout_marginBottom="12dp"
            app:icon="@android:drawable/ic_dialog_map" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPairDevices"
            style="@style/Widget.GateKeeper.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_pair_devices"
            android:layout_marginBottom="24dp"
            app:icon="@android:drawable/ic_menu_share" />

        <!-- HONK GATE — Giant Manual Override Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHonkGate"
            style="@style/Widget.GateKeeper.Button.Alarm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_honk_gate"
            android:layout_marginBottom="16dp"
            app:backgroundTint="@color/honk_orange" />

    </LinearLayout>
</ScrollView>


<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/margin_large"
    android:gravity="center">

    <!-- Title -->
    <TextView
        android:id="@+id/tvPairingTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_show_qr"
        android:textSize="@dimen/text_large"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- QR Code display area -->
    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center"
        android:background="@android:color/white"
        android:padding="8dp"
        android:contentDescription="QR Code for pairing"
        android:layout_marginBottom="24dp" />

    <!-- Session ID display -->
    <TextView
        android:id="@+id/tvSessionId"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_small"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <!-- Scan QR Button (P2 only) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanQr"
        style="@style/Widget.GateKeeper.Button.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📷 Scan QR Code"
        android:layout_marginBottom="12dp"
        app:icon="@android:drawable/ic_menu_camera" />

    <!-- Status message -->
    <TextView
        android:id="@+id/tvPairingStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_normal"
        android:textColor="@color/status_active"
        android:gravity="center"
        android:visibility="gone" />

</LinearLayout>

